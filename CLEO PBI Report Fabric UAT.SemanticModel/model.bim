                "let",
                "    Source = Sql.Database(\"x6eps4xrq2xudenlfv6naeo3i4-p55tpf3zgsfefmd74texuyh4hm.msit-datawarehouse.fabric.microsoft.com\", \"CLEO\"),",
                "    dbo_WW_Target = Source{[Schema=\"dbo\",Item=\"WW_Target\"]}[Data],",
