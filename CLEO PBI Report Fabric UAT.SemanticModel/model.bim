        "lineageTag": "54fbf7a2-6e4f-49d0-9151-13b3c3a70fd8",
        "measures": [
          {
            "name": "Total Actual",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "sumx('FC Summary Data', [FC04 Berlin] +[FC03 Atlanta] + [FC01 Barnsley])",
            "lineageTag": "3b0fdefd-7d27-4367-b1a3-1b0263dca5c0"
          },
          {
            "name": "Total Target",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "sumx('FC Summary Data', [BH Target]+[EH Target]+[AT Target])",
            "lineageTag": "7316b1f3-2bc8-4090-a76f-71123e1687e7"
          },
          {
            "name": "Var £",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "[Total Actual] - [Total Target]",
            "lineageTag": "31408b88-bf88-4672-85b4-99b38187e169"
          },
          {
            "name": "Var %",
            "expression": "[Var £] /[Total Target]",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "73fb4115-1e17-4216-9740-87372749322f"
          }
        ],
        "partitions": [
          {
            "name": "FC Summary Data",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.NestedJoin(CLEOReportData, {\"JoinCol\"}, WW_Targets, {\"TargetJoinCol\"}, \"WW_Targets\", JoinKind.LeftOuter),",
                "    #\"Expanded WW_Targets\" = Table.ExpandTableColumn(Source, \"WW_Targets\", {\"Group\", \"PRODUCT_GROUP\", \"FC01\", \"FC04\", \"FC03\"}, {\"WW_Targets.Group\", \"WW_Targets.PRODUCT_GROUP\", \"WW_Targets.FC01\", \"WW_Targets.FC04\", \"WW_Targets.FC03\"}),",
                "   #\"Added Custom1\" = Table.AddColumn(#\"Expanded WW_Targets\", \"New Group\", each if [Product_Group]   = \"Day dresses\" or [Product_Group]   = \"Evening Dresses\" then ",
                "\"DRESSES\" ",
                "else if [Product_Group]   = \"Jeans\" or [Product_Group]   = \"Casual Bottoms\" or [Product_Group]   = \"Shorts\" or [Product_Group]   = \"Skirts\"",
                "then",
                "\"BOTTOMS\"",
                "else if [Product_Group]   = \"Jersey Tops\" or [Product_Group]   = \"Woven Tops\" or [Product_Group]   = \"Knitwear\" ",
                "then",
                "\"TOPS\"",
                "else if [Product_Group]   = \"Outerwear\" or [Product_Group]   = \"Jumpsuits & Playsuits\" ",
                "then",
                "\"OTHER CLOTHING\"",
                "else if [Product_Group]   = \"Accessories\" or [Product_Group]   = \"Swimwear\" or [Product_Group]   = \"Lingerie & Nightwear\" ",
                "then",
                "\"NON CLOTHING\"",
                "else if [Product_Group]   = \"Tailoring\"",
                "then ",
                "\"TAILORING\"",
                "else if [Product_Group]   = \"Footwear\"",
                "then ",
                "\"FOOTWEAR\"",
                "else",
                "\"NOT FOUND\"),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Added Custom1\", each true),",
                "    #\"Grouped Rows\" = Table.Group(#\"Filtered Rows\", {\"New Group\", \"Buying_Division\", \"Gender\", \"Product_Group\"}, {{\"FC01 Barnsley\", each List.Sum([FC01 Barnsley]), type nullable number}, {\"FC04 Berlin\", each List.Sum([FC04 Berlin]), type nullable number}, {\"FC03 Atlanta\", each List.Sum([FC03 Atlanta]), type nullable number}, {\"BH Target\", each List.Sum([WW_Targets.FC01]), type nullable number}, {\"EH Target\", each List.Sum([WW_Targets.FC03]), type nullable number}, {\"AT Target\", each List.Sum([WW_Targets.FC04]), type nullable number}})",
                "in",
                "    #\"Grouped Rows\""
              ],
              "type": "m"
            }
          }
        ]
      },
