                "    #\"Grouped Rows\" = Table.Group(#\"Pivoted Column\", {\"Product_Group\", \"Buying_Division\", \"Gender\"}, {{\"FC01 Barnsley\", each List.Sum([FC01 Barnsley]), type nullable number}, {\"FC04 Berlin\", each List.Sum([FC04 Berlin]), type nullable number}, {\"FC03 Atlanta\", each List.Sum([FC03 Atlanta]), type nullable number}}),",
