                "    #\"Added Custom1\" = Table.AddColumn(#\"Changed Type\", \"AMP Mix\", each [Target]/ List.Sum(#\"Changed Type\"[Target])),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Added Custom1\",{{\"AMP Mix\", Percentage.Type}}),",
                "    #\"Added Custom2\" = Table.AddColumn(#\"Changed Type1\", \"Vs AMP\", each ([Actual]/[Target]) -1),",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Added Custom2\",{{\"Vs AMP\", Percentage.Type}})",
                "in",
                "    #\"Changed Type2\""
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}