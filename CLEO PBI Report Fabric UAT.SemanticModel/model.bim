                "    #\"Uppercased Text\" = Table.TransformColumns(#\"Added Custom\",{{\"Custom\", Text.Upper, type text}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Uppercased Text\",{{\"Custom\", \"TargetJoinCol\"}}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Renamed Columns\", each ([Group_Look_Up] <> null))",
